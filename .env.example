# ------------------------------------------------------------------
# AgentForge Shared — environment template
# Copy to .env and adjust for your environment before running services.
# Never commit real secrets. Secrets may also be mounted into the
# directory referenced by SECRETS_DIR and read as bare file names.
# ------------------------------------------------------------------

# --- App -----------------------------------------------------------------
APP_NAME=agentforge-platform
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0
APP_HOST=0.0.0.0
APP_PORT=8000
API_PREFIX=/api
API_VERSION=v1

# Timezone used for logging/timestamps. Use IANA names (e.g. Europe/London)
APP_TIMEZONE=UTC
# Comma separated list of trusted host patterns, e.g. "localhost,.agentforge.dev"
TRUSTED_HOSTS=localhost,127.0.0.1

# --- Logging & Observability ------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=console          # or json
LOG_JSON_INDENT=null
LOG_INCLUDE_PROCESSORS=true
# Comma separated list of secret key names to mask in logs
LOG_MASKED_KEYS=password,password_confirm,authorization,api_key,api-key,refresh_token

OTEL_SERVICE_NAME=agentforge-shared
OTEL_TRACES_EXPORTER=console  # otlp, jaeger, or console
OTEL_METRICS_EXPORTER=console
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_ENABLED=true
PROMETHEUS_PREFIX=agentforge_
PROMETHEUS_METRICS_PATH=/metrics

# --- Database ---------------------------------------------------------------
DB_ENGINE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agentforge
DB_USER=agentforge
DB_PASSWORD=changeme
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=false
DB_DRIVER=postgresql+asyncpg   # sync drivers: postgresql+psycopg
DB_SSL_MODE=disable

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SSL=false
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5
CACHE_DEFAULT_TTL=300
CACHE_NAMESPACE=agentforge

# --- JWT ----------------------------------------------------------------------
JWT_SECRET_KEY=change-me-to-a-64-byte-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_MINUTES=30
JWT_REFRESH_TOKEN_TTL_DAYS=7
JWT_ISSUER=agentforge
JWT_AUDIENCE=agentforge-api
JWT_LEEWAY_SECONDS=10
JWT_REQUIRE_EXP=true

# --- LLM ----------------------------------------------------------------------
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7
LLM_MAX_RETRIES=3
LLM_REQUEST_TIMEOUT_SECONDS=120

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

VECTOR_STORE=qdrant
VECTOR_DIMENSIONS=1536

# --- Storage -------------------------------------------------------------------
STORAGE_PROVIDER=s3
STORAGE_BUCKET=agentforge-storage
STORAGE_LOCAL_DIR=./storage
STORAGE_MAX_UPLOAD_SIZE_MB=100
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT_URL=
STORAGE_FORCE_PATH_STYLE=true

# --- Rate limiting ----------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_LIMIT=100
RATE_LIMIT_DEFAULT_WINDOW_SECONDS=60
RATE_LIMIT_BURST_LIMIT=200
RATE_LIMIT_AUTH_LIMIT=1000
RATE_LIMIT_AUTH_WINDOW_SECONDS=3600
RATE_LIMIT_EXEMPT_ROLES=admin

# --- Execution -------------------------------------------------------------------
EXECUTION_MAX_TIMEOUT_SECONDS=3600
EXECUTION_DEFAULT_TIMEOUT_SECONDS=300
EXECUTION_MAX_RETRIES=3
EXECUTION_RETRY_BACKOFF_BASE=1.0
EXECUTION_RETRY_BACKOFF_MAX=60
EXECUTION_CONCURRENCY_LIMIT=16
EXECUTION_QUEUE_CAPACITY=10000
EXECUTION_MAX_PAYLOAD_BYTES=1048576

# --- CORS --------------------------------------------------------------------------
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=600

# --- Secrets -------------------------------------------------------------------------
# Directory scanned for secret files (Docker secrets / k8s). File name == setting key.
SECRETS_DIR=./secrets
ENV_FILE=.env